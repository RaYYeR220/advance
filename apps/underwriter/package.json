{
  "name": "@advance/underwriter",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx src/bin/serve.ts",
    "serve": "tsx src/bin/serve.ts"
  },
  "dependencies": {
    "@advance/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "@x402/hono": "2.26.0",
    "hono": "^4.13.8",
    "viem": "^2.56.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@x402/fetch": "2.26.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
